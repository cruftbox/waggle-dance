DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
ALLOWED_USER_IDS=            # comma-separated Discord user IDs
OWNER_NAME=Michael
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
META_API_KEY=
AUTO_CLOSE_HOURS=24
MOCK_MODELS=0
LOG_LEVEL=INFO

# User and group IDs the container runs as. Match the owner of the data/,
# config/, and instructions/ directories on the host (run `id` to see yours).
APP_UID=1000
APP_GID=1000

# Time zone for the date the models are told (for example America/Los_Angeles). Default UTC.
TZ=UTC
